<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User Details Form</title>
</head>
<body>
<h1 style="text-align: center">User Details Form</h1>

<p>This page contains a form for filling the user information. Therefore, you are kindly requested to fill
    the form below.</p>

<div class="ui-container">
    <form class="ui-form" action="/user" method="post">
        <div class="field">
            <label>User ID</label>
            <input type="number" name="ID" placeholder="User ID">
        </div>

        <div class="field">
            <label>User's Full Name</label>
            <input type="text" name="fullName" placeholder="Full Name">
        </div>

        <div class="field">
            <label>User's Phone Number</label>
            <input type="tel" name="phone" placeholder="Phone Number">
        </div>

        <div class="field">
            <label>User's Role</label>
            <input type="text" name="role" placeholder="Role">
        </div>

        <div class="field">
            <label>User Password</label>
            <input type="password" name="password" placeholder="Password">
        </div>

        <div class="field">
            <label>Account Created On</label>
            <input type="date" name="date" placeholder="Date">
        </div>

        <button class="ui-button" type="submit">Submit</button>
    </form>
</div>

<a style="font-weight: bold" href="../static/index.html">Click on this link to return to the homepage.</a>

</body>
</html>