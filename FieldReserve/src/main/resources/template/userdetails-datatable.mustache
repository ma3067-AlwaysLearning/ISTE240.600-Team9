<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Users</title>
</head>
<body>

<h1>Users List</h1>

<a href="/user/add">Add User</a>
<a href="/">Home</a>

<br><br>

<table>
    <tr>
        <th>User ID</th>
        <th>Full Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Role</th>
        <th>Password</th>
        <th>Created At</th>
    </tr>

    {{#users}}
        <tr>
            <td>{{ID}}</td>
            <td>{{fullName}}</td>
            <td>{{email}}</td>
            <td>{{phone}}</td>
            <td>{{role}}</td>
            <td>{{password}}</td>
            <td>{{createdAt}}</td>
        </tr>
    {{/users}}
</table>

</body>
</html>