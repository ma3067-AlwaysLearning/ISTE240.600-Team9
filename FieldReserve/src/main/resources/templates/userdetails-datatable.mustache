<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Users</title>
    
        <style>
        table, th, td {
            border: 1px solid black;
        }

        table {
            border-collapse: collapse;
            margin: auto;
            width: auto;
        }

        th, td {
            padding: 10px;
        }

        th {
            background-color: #1E2E57;
            color: #F2C94C;
        }

        th:hover {
            background-color: #19274A;
            cursor: pointer;
        }

        td {
            background-color: #F2C94C;
            color: black;
        }

        td:hover {
            background-color: #E6BE45;
            cursor: pointer;
        }

    </style>
</head>
<body>

  <h1>Users List</h1>

  <a href="/user/add">Add User</a>
  <a href="/">Home</a>

  <br><br>

  <table>
      <tr>
          <th>User ID</th>
          <th>Full Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Role</th>
          <th>Password</th>
          <th>Created At</th>
      </tr>

      {{#users}}
          <tr>
              <td>{{ID}}</td>
              <td>{{fullName}}</td>
              <td>{{email}}</td>
              <td>{{phone}}</td>
              <td>{{role}}</td>
              <td>{{password}}</td>
              <td>{{createdAt}}</td>
          </tr>
      {{/users}}
    </table>
    <a style="font-weight: bold" href="/">Click on this link to return to the homepage.</a>
  </body>
</html>