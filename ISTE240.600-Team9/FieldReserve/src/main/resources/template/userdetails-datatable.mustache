<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User Details Data</title>

    <style>
        table, th, td {
            border: 1px solid black;
        }

        table {
            border-collapse: collapse;
            margin: auto;
            width: auto;
        }

        th, td {
            padding: 10px;
        }

        th {
            background-color: #1E2E57;
            color: #F2C94C;
        }

        th:hover {
            background-color: #19274A;
            cursor: pointer;
        }

        td {
            background-color: #F2C94C;
            color: black;
        }

        td:hover {
            background-color: #E6BE45;
            cursor: pointer;
        }

    </style>
</head>

<body>
<h1 style="text-align: center">User Details Data</h1>
<table>
    <tr>
        <th>User ID</th>
        <th>Full Name</th>
        <th>E-mail</th>
        <th>Phone Number</th>
        <th>Role</th>
        <th>Password</th>
        <th>Account Created On</th>
    </tr>

    <tr>
        <td>{{ID}}</td>
        <td>{{fullName}}</td>
        <td>{{email}}</td>
        <td>{{phone}}</td>
        <td>{{role}}</td>
        <td>{{password}}</td>
        <td>{{createdAt}}</td>
    </tr>
</table>
<a style="font-weight: bold" href="../static/index.html">Click on this link to return to the homepage.</a>
</body>
</html>